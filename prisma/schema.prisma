generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  price       Float
  image       String
  gallery     String
  category    String
  occasion    String
  color       String
  fabric      String
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]
}

model Order {
  id             String     @id
  customerName   String
  email          String
  phone          String
  address        String
  city           String
  state          String
  country        String
  postalCode     String?
  deliveryMethod String?
  paymentMethod  String?
  status         String     @default("pending")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  items    OrderItem[]
  payments Payment[]
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  productName String?
  productSize String?
  quantity    Int
  price       Float

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Payment {
  id        String   @id
  orderId   String
  reference String   @unique
  amount    Float
  email     String
  status    String   @default("initialized")
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model TailoringEnquiry {
  id                    String   @id @default(cuid())
  name                  String
  email                 String
  phone                 String
  outfitType            String?
  styleReference        String?
  fabric                String?
  fit                   String?
  gender                String?
  address               String?
  state                 String?
  country               String?
  postalCode            String?
  preferredDeliveryDate String?
  measurements          String?  // JSON string of all measurements
  images                String?  // JSON string of inspiration images / URLs
  budget                String?
  occasion              String?
  notes                 String?
  priceQuote            Float?
  adminNotes            String?
  status                String   @default("pending")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  adminEmail  String?
  action      String
  entityType  String
  entityId    String
  details     String?
  createdAt   DateTime @default(now())
}


model Collection {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  href      String
  image     String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

